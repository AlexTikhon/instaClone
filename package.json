{
  "name": "instaclone",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm build:packages && pnpm --parallel --filter \"./apps/*\" dev",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm build:packages && pnpm -r --if-present test",
    "test:coverage": "pnpm build:packages && pnpm -r --if-present test:coverage",
    "db:generate": "pnpm --filter @instaclone/api db:generate",
    "compose:validate": "docker compose config --quiet",
    "validate": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm compose:validate",
    "postinstall": "pnpm build:packages && pnpm db:generate"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  }
}
