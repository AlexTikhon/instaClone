    "@instaclone/api-contracts": "workspace:*",
    "@instaclone/config": "workspace:*",
    "bullmq": "6.0.9",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "8.21.0",
    "@vitest/coverage-v8": "4.1.10",
    "tsx": "4.23.12",
    "vitest": "4.1.10"
  }
}
