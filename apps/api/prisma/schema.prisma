generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String                   @unique @db.VarChar(320)
  emailVerifiedAt         DateTime?                @db.Timestamptz(3)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(3)
  disabledAt              DateTime?                @db.Timestamptz(3)
  credential              UserCredential?
  profile                 Profile?
  sessions                AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditEvents             AuthAuditEvent[]
  outgoingFollows         Follow[]                 @relation("FollowerEdges")
  incomingFollows         Follow[]                 @relation("FollowingEdges")
  outgoingFollowRequests  FollowRequest[]          @relation("FollowRequesterEdges")
  incomingFollowRequests  FollowRequest[]          @relation("FollowTargetEdges")
  outgoingBlocks          Block[]                  @relation("BlockerEdges")
  incomingBlocks          Block[]                  @relation("BlockedEdges")
  mediaAssets             MediaAsset[]
  posts                   Post[]
  stories                 Story[]                  @relation("StoryAuthor")
  storyViews              StoryView[]              @relation("StoryViewer")
  postLikes               PostLike[]
  comments                Comment[]
  savedPosts              SavedPost[]
  receivedNotifications   Notification[]           @relation("NotificationRecipient")
  actedNotifications      Notification[]           @relation("NotificationActor")

  @@map("users")
}

model UserCredential {
  userId            String   @id @db.Uuid
  passwordHash      String   @db.VarChar(255)
  passwordChangedAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model Profile {
  userId      String   @id @db.Uuid
  username    String   @unique @db.VarChar(30)
  displayName String   @db.VarChar(60)
  bio         String   @default("") @db.VarChar(160)
  websiteUrl  String?  @db.VarChar(2048)
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model AuthSession {
  id            String               @id @default(uuid()) @db.Uuid
  userId        String               @db.Uuid
  expiresAt     DateTime             @db.Timestamptz(3)
  lastUsedAt    DateTime             @default(now()) @db.Timestamptz(3)
  revokedAt     DateTime?            @db.Timestamptz(3)
  revokeReason  SessionRevokeReason?
  ipAddress     String?              @db.VarChar(45)
  userAgent     String?              @db.VarChar(512)
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuthAuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  sessionId  String?  @db.Uuid
  eventType  String   @db.VarChar(64)
  outcome    String   @db.VarChar(16)
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(512)
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([occurredAt])
  @@map("auth_audit_events")
}

model Follow {
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  follower    User     @relation("FollowerEdges", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("FollowingEdges", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt])
  @@map("follows")
}

model FollowRequest {
  requesterId String   @db.Uuid
  targetId    String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  requester   User     @relation("FollowRequesterEdges", fields: [requesterId], references: [id], onDelete: Cascade)
  target      User     @relation("FollowTargetEdges", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([requesterId, targetId])
  @@index([targetId, createdAt, requesterId])
  @@map("follow_requests")
}

model MediaAsset {
  id                   String           @id @default(uuid()) @db.Uuid
  ownerId              String           @db.Uuid
  kind                 MediaKind
  objectKey            String           @unique @db.VarChar(512)
  thumbnailObjectKey   String?          @unique @db.VarChar(512)
  declaredMimeType     String           @db.VarChar(128)
  declaredSizeBytes    Int
  verifiedSizeBytes    Int?
  width                Int?
  height               Int?
  durationMs           Int?
  status               MediaAssetStatus @default(PENDING_UPLOAD)
  failureCode          String?          @db.VarChar(64)
  processingStartedAt  DateTime?        @db.Timestamptz(3)
  processingLeaseUntil DateTime?        @db.Timestamptz(3)
  processingWorkerId   String?          @db.VarChar(128)
  createdAt            DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(3)
  owner                User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  postMedia            PostMedia?
  stories              Story[]

  @@index([ownerId, createdAt])
  @@index([status, updatedAt])
  @@index([status, processingLeaseUntil])
  @@map("media_assets")
}

model Post {
  id            String         @id @default(uuid()) @db.Uuid
  authorId      String         @db.Uuid
  caption       String         @default("") @db.VarChar(2200)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?      @db.Timestamptz(3)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media         PostMedia[]
  likes         PostLike[]
  comments      Comment[]
  savedBy       SavedPost[]
  notifications Notification[]

  @@index([authorId, createdAt, id])
  @@index([deletedAt, createdAt, id])
  @@map("posts")
}

model PostLike {
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("post_likes")
}

model Comment {
  id            String         @id @default(uuid()) @db.Uuid
  postId        String         @db.Uuid
  authorId      String         @db.Uuid
  body          String         @db.VarChar(1000)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?      @db.Timestamptz(3)
  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([postId, deletedAt, createdAt, id])
  @@index([authorId, createdAt])
  @@map("comments")
}

model SavedPost {
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("saved_posts")
}

model PostMedia {
  postId       String     @db.Uuid
  mediaAssetId String     @unique @db.Uuid
  position     Int
  post         Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([postId, mediaAssetId])
  @@unique([postId, position])
  @@map("post_media")
}

model Story {
  id           String      @id @default(uuid()) @db.Uuid
  authorId     String      @db.Uuid
  mediaAssetId String      @db.Uuid
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime    @db.Timestamptz(3)
  deletedAt    DateTime?   @db.Timestamptz(3)
  author       User        @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset  @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  views        StoryView[]

  @@index([authorId, expiresAt, createdAt, id])
  @@index([expiresAt, authorId])
  @@map("stories")
}

model StoryView {
  storyId  String   @db.Uuid
  viewerId String   @db.Uuid
  viewedAt DateTime @default(now()) @db.Timestamptz(3)
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer   User     @relation("StoryViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  @@id([storyId, viewerId])
  @@index([storyId, viewedAt, viewerId])
  @@index([viewerId, storyId])
  @@map("story_views")
}

model OutboxEvent {
  eventId       String    @id @default(uuid()) @db.Uuid
  eventName     String    @db.VarChar(128)
  eventVersion  Int
  aggregateType String    @db.VarChar(64)
  aggregateId   String    @db.Uuid
  occurredAt    DateTime  @default(now()) @db.Timestamptz(3)
  correlationId String    @db.VarChar(128)
  payload       Json
  publishedAt   DateTime? @db.Timestamptz(3)
  lockedAt      DateTime? @db.Timestamptz(3)
  lockedBy      String?   @db.VarChar(128)
  attemptCount  Int       @default(0)
  lastError     String?   @db.VarChar(512)

  @@index([publishedAt, lockedAt, occurredAt])
  @@map("outbox_events")
}

model ConsumerEventReceipt {
  eventId      String   @db.Uuid
  consumerName String   @db.VarChar(128)
  processedAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([eventId, consumerName])
  @@map("consumer_event_receipts")
}

model Notification {
  id               String           @id @default(uuid()) @db.Uuid
  sourceEventId    String           @unique @db.Uuid
  recipientId      String           @db.Uuid
  actorId          String?          @db.Uuid
  type             NotificationType
  postId           String?          @db.Uuid
  commentId        String?          @db.Uuid
  actorUsername    String           @db.VarChar(30)
  actorDisplayName String           @db.VarChar(60)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  readAt           DateTime?        @db.Timestamptz(3)
  recipient        User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor            User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  post             Post?            @relation(fields: [postId], references: [id], onDelete: SetNull)
  comment          Comment?         @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt, id])
  @@map("notifications")
}

model Block {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  blocker   User     @relation("BlockerEdges", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedEdges", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model RefreshToken {
  id         String      @id @default(uuid()) @db.Uuid
  sessionId  String      @db.Uuid
  tokenHash  String      @unique @db.Char(64)
  expiresAt  DateTime    @db.Timestamptz(3)
  consumedAt DateTime?   @db.Timestamptz(3)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  session    AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, consumedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum SessionRevokeReason {
  LOGOUT
  REFRESH_TOKEN_REUSE
  PASSWORD_CHANGE
  SECURITY_EVENT
  ACCOUNT_DISABLED
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum MediaAssetStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  FOLLOW_REQUEST
}
