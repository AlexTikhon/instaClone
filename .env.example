NODE_ENV=development
LOG_LEVEL=debug

API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Replace both values outside local development. Cookies must be secure behind TLS.
AUTH_ACCESS_TOKEN_SECRET=local-access-secret-change-me-at-least-32-characters
AUTH_REFRESH_TOKEN_PEPPER=local-refresh-pepper-change-me-at-least-32-characters
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false

# Optional Docker Compose host-port overrides.
WEB_HOST_PORT=3000
API_HOST_PORT=4000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

DATABASE_URL=postgresql://instaclone:instaclone@localhost:5432/instaclone?schema=public
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=instaclone
S3_SECRET_KEY=instaclone-local-secret
S3_BUCKET=instaclone-media
S3_FORCE_PATH_STYLE=true

WORKER_CONCURRENCY=4
